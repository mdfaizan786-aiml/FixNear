{
  "version": 2,
  "builds": [
    {
      "src": "docs/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/mock-data.js",
      "dest": "/docs/mock-data.js"
    },
    {
      "src": "/supabase-client.js",
      "dest": "/docs/supabase-client.js"
    },
    {
      "src": "/supabase-config.js",
      "dest": "/docs/supabase-config.js"
    },
    {
      "src": "/robots.txt",
      "dest": "/docs/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/docs/sitemap.xml"
    },
    {
      "src": "/404",
      "dest": "/docs/404.html"
    },
    {
      "src": "/(.*)",
      "dest": "/docs/index.html"
    }
  ]
}
